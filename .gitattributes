* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Notebooks are executable walkthroughs and exported evidence; implementation lives in Python and
# shell entry points, so do not include notebook JSON in GitHub's language breakdown.
*.ipynb linguist-detectable=false

*.obj binary
*.lib binary
*.exp binary

# Results are immutable machine evidence. Preserve their source bytes exactly so
# exported CSV/log hashes remain valid after a clone, including historical CRLF files.
/results/** -text -eol
